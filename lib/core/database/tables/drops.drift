import 'package:bucket_drop/core/database/tables/buckets.drift';
import 'package:bucket_drop/core/database/tables/drop_categories.drift';
import 'package:bucket_drop/core/database/tables/subscribed_drops.drift';

CREATE TABLE drops (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  title TEXT NOT NULL,
  from_bucket_id INTEGER REFERENCES buckets(id) ON DELETE RESTRICT,
  to_bucket_id INTEGER REFERENCES buckets(id) ON DELETE RESTRICT,
  drop_category_id INTEGER REFERENCES drop_categories(id) ON DELETE SET NULL,
  subscribed_drop_id INTEGER REFERENCES subscribed_drops(id) ON DELETE SET NULL,
  parent_drop_id INTEGER REFERENCES drops(id) ON DELETE CASCADE,
  amount INTEGER NOT NULL,
  dropped_on DATETIME NOT NULL,
  notes TEXT,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
) AS DropTable;


-- 一覧取得
getDrops: 
SELECT 
    drops.*,
    fb.name as from_bucket_name,
    tb.name as to_bucket_name,
    dc.name as drop_category_name,
    dc.icon as drop_category_icon,
    sd.title as subscribed_drop_title,
    sd.name as subscribed_drop_name,
    sd.notes as subscribed_drop_notes
FROM drops 
LEFT JOIN buckets AS fb ON drops.from_bucket_id = fb.id
LEFT JOIN buckets AS tb ON drops.to_bucket_id = tb.id
LEFT JOIN drop_categories AS dc ON drops.drop_category_id = dc.id
LEFT JOIN subscribed_drops AS sd ON drops.subscribed_drop_id = sd.id
ORDER BY dropped_on DESC;
