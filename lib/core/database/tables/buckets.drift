import 'package:bucket_drop/core/enums/bucket_category.dart';

CREATE TABLE buckets (
  id INT NOT NULL PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  is_income_default BOOLEAN NOT NULL DEFAULT FALSE,
  is_expense_default BOOLEAN NOT NULL DEFAULT FALSE,
  bucket_category ENUMNAME(BucketCategory) NOT NULL,
  expected_rate REAL NOT NULL DEFAULT 0.0,
  sort INT NOT NULL,
  is_archived BOOLEAN NOT NULL DEFAULT TRUE,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
) AS BucketTable;

-- CREATE ---------------------------------------------------------------------
-- 新規登録
createBucket:
INSERT INTO buckets $entry;

-- READ -----------------------------------------------------------------------
-- 一件取得
getBucket:
SELECT * FROM buckets WHERE id = :id;

-- 全件取得
getBuckets:
SELECT * FROM buckets ORDER BY sort ASC;

-- 収入のデフォルトバケットを取得
getIncomeDefaultBucket:
SELECT * FROM buckets WHERE is_income_default = TRUE;

-- 支出のデフォルトバケットを取得
getExpenseDefaultBucket:
SELECT * FROM buckets WHERE is_expense_default = TRUE;

-- UPDATE ---------------------------------------------------------------------
updateBucket:
UPDATE buckets SET 
    name = :name,
    expected_rate = :expectedRate,
    updated_at = CURRENT_TIMESTAMP
WHERE id = :id;

-- すべての収入デフォルトを解除
clearIncomeDefault:
UPDATE buckets SET is_income_default = FALSE WHERE is_income_default = TRUE;
-- 指定したバケットを収入デフォルトに設定
setIncomeDefault:
UPDATE buckets SET is_income_default = TRUE WHERE id = :id;

-- すべての支出デフォルトを解除
clearExpenseDefault:
UPDATE buckets SET is_expense_default = FALSE WHERE is_expense_default = TRUE;
-- 指定したバケットを支出デフォルトに設定
setExpenseDefault:
UPDATE buckets SET is_expense_default = TRUE WHERE id = :id;

-- 並び順を更新
updateSort:
UPDATE buckets SET sort = :sort WHERE id = :id;

-- DELETE ---------------------------------------------------------------------
-- アーカイブ
archiveBucket:
UPDATE buckets SET is_archived = TRUE WHERE id = :id;

-- アーカイブ解除
unarchiveBucket:
UPDATE buckets SET is_archived = FALSE WHERE id = :id;
