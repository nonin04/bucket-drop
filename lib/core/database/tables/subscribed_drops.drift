import 'package:bucket_drop/core/database/tables/buckets.drift';
import 'package:bucket_drop/core/database/tables/drop_categories.drift';
import 'package:bucket_drop/core/enums/frequency.dart';

CREATE TABLE subscribed_drops (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL,
  from_bucket_id INTEGER REFERENCES buckets(id) ON DELETE RESTRICT,
  to_bucket_id INTEGER REFERENCES buckets(id) ON DELETE RESTRICT,
  drop_category_id INTEGER REFERENCES drop_categories(id) ON DELETE SET NULL,
  title TEXT NOT NULL,
  amount INTEGER NOT NULL,
  frequency ENUMNAME(Frequency) NOT NULL,
  repeat_interval INTEGER NOT NULL,
  starts_on DATETIME NOT NULL,
  ends_on DATETIME,
  is_active BOOLEAN NOT NULL DEFAULT TRUE,
  notes TEXT,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP
) AS SubscribedDropTable;

-- C 新規登録
createSubscribedDrop:
INSERT INTO subscribed_drops $entry;


-- R 一件取得
getSubscribedDrop:
SELECT * FROM subscribed_drops WHERE id = :id;

-- R 全件取得
getSubscribedDrops:
SELECT * FROM subscribed_drops ORDER BY starts_on DESC;

-- R アクティブなもののみ
getActiveSubscribedDrops:
SELECT * FROM subscribed_drops WHERE is_active = TRUE ORDER BY starts_on DESC;

-- R 非アクティブなもののみ
getUnactiveSubscribedDrops:
SELECT * FROM subscribed_drops WHERE is_active = FALSE ORDER BY starts_on DESC;

-- U 更新
updateSubscribedDrop:
UPDATE subscribed_drops SET
  name = :name,
  from_bucket_id = :fromBucketId,
  to_bucket_id = :toBucketId,
  drop_category_id = :dropCategoryId,
  title = :title,
  amount = :amount,
  frequency = :frequency,
  repeat_interval = :repeatInterval,
  starts_on = :startsOn,
  ends_on = :endsOn,
  is_active = :isActive,
  notes = :notes,
  updated_at = CURRENT_TIMESTAMP
WHERE id = :id;

-- D 削除
deleteSubscribedDrop:
DELETE FROM subscribed_drops WHERE id = :id;
